{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/dist/index.js": { "maxDuration": 30 },
    "api/dist/bot.js":   { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/bot", "destination": "/api/dist/bot" },
    { "source": "/api/(.*)", "destination": "/api/dist/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
