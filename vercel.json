{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/daily-suite",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-suite",
      "schedule": "15 0 * * 1"
    }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/bot.js":   { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/api/bot", "destination": "/api/bot" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
