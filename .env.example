# ── Backend (Render + Vercel serverless) — barchasi MAJBURIY ────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
BOT_TOKEN="123456:ABC-your-bot-token"            # Telegram initData HMAC tekshiruvi uchun
BOT_WEBHOOK_SECRET="random-long-secret"          # Telegram webhook header tekshiruvi (masalan: openssl rand -hex 32)
APP_URL="https://yhq-mini-app.vercel.app"        # Mini app URL (bot tugmalarida)
ALLOWED_ORIGIN="https://yhq-mini-app.vercel.app" # CORS — frontend domeni

# ── Ixtiyoriy ───────────────────────────────────────────────────────────────
SENTRY_DSN="https://xxx@yyy.ingest.sentry.io/zzz"   # bo'sh qoldirilsa — o'chiq
PORT=8080
NODE_ENV=production
GEMINI_API_KEY=""                  # AI Tutor (Gemini) — bo'sh bo'lsa endpoint 503
CRON_SECRET=""                     # Vercel Cron endpoint himoyasi — bo'sh bo'lsa dev-only
TEST_DATABASE_URL=""               # integration testlar uchun ALOHIDA Neon DB (npm run test:integration)

# ── Multi-provider auth (telefon+parol / TG Login Widget) ──────────────────
SESSION_TTL_DAYS=30        # login sessiyasi (opaque token) TTL — default 30 kun
BOT_USERNAME="kiwi_bot"    # @ belgisisiz — APK'dagi "Telegram ulash" t.me deep-link uchun
OTP_PEPPER=""              # OTP hash server pepper (HMAC-SHA256 kalit, min 16 belgi)
                           # masalan: openssl rand -hex 32. Bo'sh = plain sha256 (faqat dev)

# ── SMS OTP (Eskiz.uz — O'zbekiston SMS gateway) ────────────────────────────
# Ro'yxatdan o'tish: https://notify.eskiz.uz
# SMS_ENABLED=true bo'lsa ESKIZ_EMAIL va ESKIZ_PASSWORD MAJBURIY.
# Dev muhitda SMS_ENABLED=false qoldiring — kodlar console'ga chiqadi.
ESKIZ_EMAIL=""                   # Eskiz.uz hisob email'i
ESKIZ_PASSWORD=""                # Eskiz.uz hisob paroli
SMS_ENABLED="false"              # true = SMS yuboriladi, false = dev mode (console log)
# SMS_CALLBACK_URL=""            # optional — SMS delivery status webhook

# ── Frontend build (vite) — FAQAT APK/aloqacha-frontend build uchun ─────────
# Oddiy Vercel deploy'da KERAK EMAS (frontend va API bir domen — '/api' fallback).
# Capacitor APK lokal bundle'dan yuklanadi, shuning uchun prod manzil aniq yoziladi
# (npm run build dan OLDIN shu qiymatlar .env/.env.local da bo'lishi kerak):
VITE_API_BASE_URL="https://yhq-mini-app.vercel.app/api"      # prod HTTP API
VITE_WS_URL="wss://<ws-host>/ws/octagon"                     # prod WS (Octagon)
VITE_BOT_USERNAME="kiwi_bot"                                 # @ belgisisiz — TG Login Widget tugmasi uchun
