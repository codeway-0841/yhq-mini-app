# ── Backend (Render + Vercel serverless) — barchasi MAJBURIY ────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
BOT_TOKEN="123456:ABC-your-bot-token"            # Telegram initData HMAC tekshiruvi uchun
BOT_WEBHOOK_SECRET="random-long-secret"          # Telegram webhook header tekshiruvi (masalan: openssl rand -hex 32)
APP_URL="https://app.kivvi.uz"        # Mini app URL (bot tugmalarida) — ILOVA domeni (landing emas!)
# CORS + WS origin allowlist — vergul bilan bir nechta origin. ILOVA domeni BIRINCHI.
# DIQQAT: Render (yhq-websocket-server) va Vercel env'lari ALOHIDA — domen o'zgarganda
# IKKALASIDA ham yangilash SHART (2026-08-31 incident: Render'da eski www.kivvi.uz
# qolib, duel "Aloqa uzildi" bergan — HTTP API Vercel'da bo'lgani uchun ishlayvergan).
ALLOWED_ORIGIN="https://app.kivvi.uz,https://www.kivvi.uz,https://kivvi.uz"

# ── Ixtiyoriy ───────────────────────────────────────────────────────────────
SENTRY_DSN="https://xxx@yyy.ingest.sentry.io/zzz"   # bo'sh qoldirilsa — o'chiq
PORT=8080
NODE_ENV=production
GEMINI_API_KEY=""                  # AI Tutor (Gemini) — bo'sh bo'lsa endpoint 503
CRON_SECRET=""                     # Vercel Cron endpoint himoyasi — bo'sh bo'lsa dev-only
TEST_DATABASE_URL=""               # integration testlar uchun ALOHIDA Neon DB (npm run test:integration)

# ── Multi-provider auth (telefon+parol / TG Login Widget) ──────────────────
SESSION_TTL_DAYS=30        # login sessiyasi (opaque token) TTL — default 30 kun
INITDATA_MAX_AGE_SECONDS=86400 # initData auth_date replay oynasi (sekund). Kod default'i 3600,
                               # lekin PROD=86400 (Vercel+Render env): Mini App sessiyalari fonda
                               # kunlab ochiq turadi — 1 soatlik oyna har sessiyani o'ldirardi
                               # (2026-08-27 incident). Telegram reload'da auth_date YANGILANMAYDI
                               # — eskirganda client "yopib-qayta oching" ekranini ko'rsatadi.
BOT_USERNAME="kiwi_uz_bot"    # @ belgisisiz — APK'dagi "Telegram ulash" t.me deep-link uchun
OTP_PEPPER=""              # OTP hash server pepper (HMAC-SHA256 kalit, min 16 belgi)
                           # masalan: openssl rand -hex 32. Bo'sh = plain sha256 (faqat dev)

# ── SMS OTP (Eskiz.uz — O'zbekiston SMS gateway) ────────────────────────────
# Ro'yxatdan o'tish: https://notify.eskiz.uz
# SMS_ENABLED=true bo'lsa ESKIZ_EMAIL va ESKIZ_PASSWORD MAJBURIY.
# Dev muhitda SMS_ENABLED=false qoldiring — kodlar console'ga chiqadi.
ESKIZ_EMAIL=""                   # Eskiz.uz hisob email'i
ESKIZ_PASSWORD=""                # Eskiz.uz hisob paroli
SMS_ENABLED="false"              # true = SMS yuboriladi, false = dev mode (console log)
# SMS_CALLBACK_URL=""            # optional — SMS delivery status webhook

# ── Email (Resend — email verification / password reset) ────────────────────
# Ikkalasi JUFT bo'ladi: RESEND_API_KEY bo'lsa EMAIL_FROM ham kerak (aks holda
# email oqimlari 503). Ro'yxatdan o'tish: https://resend.com
RESEND_API_KEY=""              # re_xxxxxxxx
EMAIL_FROM=""                  # tasdiqlangan domen, masalan: "YHQ <hello@kiwi.uz>"
# Email linklarining host qismi shunga tekshiriladi (open-redirect himoyasi):
APP_DOMAIN="kiwi.uz"           # prod domen (subdomain'lar ham ruxsat)

# ── Click Payment (Click.uz — Premium to'lovlar) ────────────────────────────
# To'liq yoqish uchun HAMMASI kerak; ixtiyoriy bittasi yozilib qolsa prod boot
# FATAL (assertProdConfig: CLICK_SECRET_KEY shart secret-juftlik qoidasi).
CLICK_SERVICE_ID=""            # Click kabinetdan
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""            # prepare/complete callback imzo tekshiruvi (MD5+HMAC protokol)
CLICK_MERCHANT_USER_ID=""

# ── Frontend build (vite) — FAQAT APK/aloqacha-frontend build uchun ─────────
# Oddiy Vercel deploy'da KERAK EMAS (frontend va API bir domen — '/api' fallback).
# Capacitor APK lokal bundle'dan yuklanadi, shuning uchun prod manzil aniq yoziladi
# (npm run build dan OLDIN shu qiymatlar .env/.env.local da bo'lishi kerak):
VITE_API_BASE_URL="https://www.kivvi.uz/api"      # prod HTTP API
VITE_WS_URL="wss://<ws-host>/ws/octagon"                     # prod WS (Octagon)
VITE_BOT_USERNAME="kiwi_uz_bot"                                 # @ belgisisiz — TG Login Widget tugmasi uchun
