# ─────────────────────────────────────────────
# Required — app will not start without these
# ─────────────────────────────────────────────

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram bot token (from @BotFather)
BOT_TOKEN=1234567890:AAAA-xxxx-example-token

# ─────────────────────────────────────────────
# Optional — defaults shown
# ─────────────────────────────────────────────

# Express server port
PORT=3001

# CORS — Vite dev server during development, Telegram domain in production
ALLOWED_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# Frontend (Vite) — prefix all with VITE_
# ─────────────────────────────────────────────

# Backend API base URL (consumed by src/lib/api.ts via import.meta.env)
VITE_API_BASE_URL=http://localhost:3001
