    {
      "id": "5a2fee0f-b3a5-49ad-9479-9f439a6aff6d",
      "test_id": "d2a92667-73b2-40b5-a5b1-7357e72acf56",
      "order_number": 30,
      "question_text": "Limitni hisoblang: Lim (x -> 2) (x^2 - 4) / (x - 2).",
      "options": {
        "a": "4",
        "b": "2",
        "c": "0",
        "d": "Mavjud emas"
      },
      "correct_option": "a",
      "explanation": "Suratdagi qisqa ko'paytirish formulasidan foydalanib, ifodani ko'paytuvchilarga ajratamiz va qisqartiramiz:\n\n$$\\lim_{x \\to 2} \\frac{x^2 - 4}{x - 2} = \\lim_{x \\to 2} \\frac{(x - 2)(x + 2)}{x - 2} = \\lim_{x \\to 2} (x + 2) = 2 + 2 = 4$$\n\nTo'g'ri javob: **A) 4**",
      "created_at": "0001-01-01T00:00:00Z"
    }
