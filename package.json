  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "grammy": "^1.45.1",
    "lucide-react": "^0.446.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.47",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:api": "node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['server/api-entry/index.ts','server/api-entry/bot.ts'],bundle:true,platform:'node',format:'esm',outdir:'api/dist',packages:'external'})\"",
    "build:server": "node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['server/index.ts'],bundle:true,platform:'node',format:'esm',outdir:'server/dist',packages:'external'})\"",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && npm run build:api && npm run build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/seed-yhq.ts",
    "db:seed:yhq": "tsx server/seed-yhq.ts",
    "db:seed:explanations": "tsx server/seed-explanations.ts",
    "db:seed:russian": "tsx server/seed-russian.ts",
    "bot:profile": "tsx server/set-bot-profile.ts",
    "loadtest:octagon": "tsx server/load-test-octagon.ts",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "tsx server/check-test-db.ts && vitest run tests/integration --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:watch": "vitest"
  },
  "type": "module"
}
