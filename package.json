  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['api/index.ts','api/bot.ts'],bundle:true,platform:'node',format:'esm',outdir:'api/dist',packages:'external'})\"",
    "vercel-build": "npm run build:api && npm run build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "type": "module"
