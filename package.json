{
  "name": "yhq-mini-app",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <25"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "grammy": "^1.45.1",
    "lucide-react": "^0.446.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.47",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['server/api-entry/index.ts','server/api-entry/bot.ts'],bundle:true,platform:'node',format:'esm',outdir:'api/dist',packages:'external'})\"",
    "build:server": "node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['server/standalone.ts'],bundle:true,platform:'node',format:'esm',outdir:'server/dist',packages:'external'})\"",
    "vercel-build": "npm run db:migrate && npm run build:api && npm run build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/seed.ts",
    "db:seed:explanations": "tsx server/seed-explanations.ts",
    "db:seed:shop": "tsx server/seed-shop.ts",
    "bot:profile": "tsx server/set-bot-profile.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx server/check-test-db.ts && vitest run tests/integration",
    "test:watch": "vitest"
  },
  "type": "module"
}
